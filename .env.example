# Copy to .env (and never commit the real file) or export these as real
# environment variables before starting the application.

SPRING_PROFILES_ACTIVE=dev

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/materialGrid
DB_USERNAME=materialGrid
DB_PASSWORD=change-me

# ── App ──────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SESSION_IDLE_TIMEOUT_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
